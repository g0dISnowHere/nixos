#!/usr/bin/env bash
# Runs only staged formatting and Markdown linting.

set -e

# Prevent running as root (would create root-owned git files)
if [ "$(id -u)" = "0" ]; then
    echo "❌ Pre-commit hook must run as regular user, not root"
    echo "   Do not use 'sudo git commit' or run nix commands with sudo"
    exit 1
fi

echo "🔍 Running pre-commit checks..."
echo ""

# Capture the currently staged files so we can re-stage only those.
staged_files_file="/tmp/pre-commit-staged-files.txt"
git diff --name-only --cached > "$staged_files_file"
has_nix_files=0
has_markdown_files=0

if grep -E '\.nix$' "$staged_files_file" | grep -vq -x "dconf.nix"; then
    has_nix_files=1
fi

if grep -Eq '\.md$' "$staged_files_file"; then
    has_markdown_files=1
fi


if [ "$has_nix_files" -eq 0 ] && [ "$has_markdown_files" -eq 0 ]; then
    echo "   ℹ️  No staged Nix or Markdown files requiring basic checks; skipping."
    exit 0
fi
cleanup_staged_file() {
    rm -f "$staged_files_file"
}
trap cleanup_staged_file EXIT

# === Format Code ===
if [ "$has_nix_files" -eq 1 ]; then
    echo "1️⃣  Formatting code with flake-fmt..."
    nix run --no-write-lock-file .#flake-fmt --
    if git diff-index --quiet HEAD --; then
        echo "   ✓ No formatting changes"
    else
        echo "   ℹ️  Code was reformatted, staging changes..."
        # Re-stage only the files that were staged before formatting.
        if [ -s "$staged_files_file" ]; then
            while IFS= read -r path; do
                if [ -e "$path" ] || [ -L "$path" ]; then
                    git add -- "$path"
                else
                    if git ls-files --error-unmatch -- "$path" >/dev/null 2>&1; then
                        git add -u -- "$path"
                    fi
                fi
            done < "$staged_files_file"
        fi
    fi
else
    echo "1️⃣  No staged .nix files; skipping nix fmt."
fi
echo ""

# === Auto-fix staged Markdown ===
if [ "$has_markdown_files" -eq 1 ]; then
    markdown_files=()
    while IFS= read -r path; do
        markdown_files+=("$path")
    done < <(grep -E '\.md$' "$staged_files_file")

    echo "2️⃣  Auto-fixing staged Markdown..."
    bash ./scripts/lint-markdown.sh --fix "${markdown_files[@]}"
    git add -- "${markdown_files[@]}"
else
    echo "2️⃣  No staged .md files; skipping markdown autofix."
fi

echo ""


echo "✅ Basic pre-commit linting passed!"
echo ""
